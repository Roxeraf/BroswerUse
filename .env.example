# Claude does the planning: natural language in, browser actions out.
ANTHROPIC_API_KEY=sk-ant-...

# Jev (TypeSafe AI) does the fast typed decisions inside the loop:
# risk scoring, page classification, done-checks, element disambiguation.
TYPESAFE_API_KEY=...

# --- optional ---
# BROWSERUSE_BROWSER=brave          # brave | chrome
# BROWSERUSE_CDP_PORT=9222
# BROWSERUSE_REAL_PROFILE=0         # 1 = attach to your everyday profile (see README)
# BROWSERUSE_MODEL=claude-opus-5
# BROWSERUSE_JEV_MODEL=jev-latest
# BROWSERUSE_RISK_THRESHOLD=1.5     # confirm anything scoring at or above this
# BROWSERUSE_MAX_STEPS=40
# BROWSERUSE_HEADLESS=0
